{
  "manifest_version": 3,
  "name": "Página Inicial",
  "version": "1.0.0",
  "description": "Sites favoritos integrados com navegador. Personalizados.",
  "permissions": ["storage", "bookmarks"],
  "host_permissions": [
    "*://*.justwatch.com/*",
    "*://*.sofascore.com/*",
    "*://*.sofascore.app/*",
    "*://*.espn.com/*",
    "*://*.espncdn.com/*",
    "*://*.ufc.com/*",
    "*://*.ufc.com.br/*"
  ],
  "action": {
    "default_title": "Página Inicial",
    "default_icon": {
      "16": "home16.png",
      "32": "home32.png"
    }
  },
  "icons": {
    "16": "home16.png",
    "32": "home32.png",
    "48": "home32.png",
    "128": "home32.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
